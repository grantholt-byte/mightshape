{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/human-model.schema.json",
  "title": "MightShape Human Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["human_model_version", "identity", "life_story", "present_life", "professional_model", "worldview", "values", "cognition", "emotional_model", "communication", "contradictions", "blind_spots", "knowledge_boundaries", "relationships_with_council", "design_behavior", "persistent_project_memory", "current_state"],
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "memoryEntry": {
      "type": "object",
      "required": ["cycle", "statement"],
      "properties": {
        "cycle": {"type": "integer", "minimum": 1},
        "statement": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "changed_because": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "human_model_version": {"const": "1.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "age", "home_region", "occupation", "previous_occupations", "education"],
      "properties": {
        "name": {"type": "string"},
        "age": {"type": "integer", "minimum": 18},
        "home_region": {"type": "string"},
        "occupation": {"type": "string"},
        "previous_occupations": {"$ref": "#/$defs/stringArray"},
        "education": {"$ref": "#/$defs/stringArray"}
      }
    },
    "life_story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childhood_context", "adolescence", "education_path", "career_path", "family_and_relationships", "caregiving_context", "formative_events", "major_successes", "major_failures", "turning_points"],
      "properties": {
        "childhood_context": {"type": "string"},
        "adolescence": {"type": "string"},
        "education_path": {"type": "string"},
        "career_path": {"type": "string"},
        "family_and_relationships": {"type": "string"},
        "caregiving_context": {"type": "string"},
        "formative_events": {"$ref": "#/$defs/stringArray"},
        "major_successes": {"$ref": "#/$defs/stringArray"},
        "major_failures": {"$ref": "#/$defs/stringArray"},
        "turning_points": {"$ref": "#/$defs/stringArray"}
      }
    },
    "present_life": {
      "type": "object",
      "additionalProperties": false,
      "required": ["household", "routines", "responsibilities", "hobbies", "communities", "interests", "financial_orientation", "current_pressures", "aspirations"],
      "properties": {
        "household": {"type": "string"},
        "routines": {"$ref": "#/$defs/stringArray"},
        "responsibilities": {"$ref": "#/$defs/stringArray"},
        "hobbies": {"$ref": "#/$defs/stringArray"},
        "communities": {"$ref": "#/$defs/stringArray"},
        "interests": {"$ref": "#/$defs/stringArray"},
        "financial_orientation": {"type": "string"},
        "current_pressures": {"$ref": "#/$defs/stringArray"},
        "aspirations": {"$ref": "#/$defs/stringArray"}
      }
    },
    "professional_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expertise", "workflows", "vocabulary", "tools", "accumulated_pattern_recognition", "incentives", "constraints", "frustrations", "professional_values"],
      "properties": {
        "expertise": {"$ref": "#/$defs/stringArray"},
        "workflows": {"$ref": "#/$defs/stringArray"},
        "vocabulary": {"$ref": "#/$defs/stringArray"},
        "tools": {"$ref": "#/$defs/stringArray"},
        "accumulated_pattern_recognition": {"$ref": "#/$defs/stringArray"},
        "incentives": {"$ref": "#/$defs/stringArray"},
        "constraints": {"$ref": "#/$defs/stringArray"},
        "frustrations": {"$ref": "#/$defs/stringArray"},
        "professional_values": {"$ref": "#/$defs/stringArray"}
      }
    },
    "worldview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["people", "institutions", "technology", "authority", "expertise", "markets", "creativity", "risk", "fairness", "progress", "uncertainty"],
      "properties": {
        "people": {"type": "string"},
        "institutions": {"type": "string"},
        "technology": {"type": "string"},
        "authority": {"type": "string"},
        "expertise": {"type": "string"},
        "markets": {"type": "string"},
        "creativity": {"type": "string"},
        "risk": {"type": "string"},
        "fairness": {"type": "string"},
        "progress": {"type": "string"},
        "uncertainty": {"type": "string"}
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "values_in_tension"],
      "properties": {
        "primary": {"$ref": "#/$defs/stringArray"},
        "secondary": {"$ref": "#/$defs/stringArray"},
        "values_in_tension": {"$ref": "#/$defs/stringArray"}
      }
    },
    "cognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_notices", "attention_bias", "reasoning_style", "analogy_style", "decision_style", "ambiguity_tolerance", "novelty_seeking", "skepticism", "risk_tolerance", "social_orientation", "systems_orientation"],
      "properties": {
        "first_notices": {"$ref": "#/$defs/stringArray"},
        "attention_bias": {"$ref": "#/$defs/stringArray"},
        "reasoning_style": {"type": "string"},
        "analogy_style": {"type": "string"},
        "decision_style": {"type": "string"},
        "ambiguity_tolerance": {"type": "string"},
        "novelty_seeking": {"type": "string"},
        "skepticism": {"type": "string"},
        "risk_tolerance": {"type": "string"},
        "social_orientation": {"type": "string"},
        "systems_orientation": {"type": "string"}
      }
    },
    "emotional_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energizers", "irritants", "anxieties", "pride", "sensitivities", "humor"],
      "properties": {
        "energizers": {"$ref": "#/$defs/stringArray"},
        "irritants": {"$ref": "#/$defs/stringArray"},
        "anxieties": {"$ref": "#/$defs/stringArray"},
        "pride": {"$ref": "#/$defs/stringArray"},
        "sensitivities": {"$ref": "#/$defs/stringArray"},
        "humor": {"type": "string"}
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary", "sentence_style", "disagreement_style", "persuasion_style", "question_style", "humor_style", "typical_verbosity"],
      "properties": {
        "vocabulary": {"$ref": "#/$defs/stringArray"},
        "sentence_style": {"type": "string"},
        "disagreement_style": {"type": "string"},
        "persuasion_style": {"type": "string"},
        "question_style": {"type": "string"},
        "humor_style": {"type": "string"},
        "typical_verbosity": {"type": "string"}
      }
    },
    "contradictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["belief", "behavior", "source_of_tension"],
        "properties": {
          "belief": {"type": "string"},
          "behavior": {"type": "string"},
          "source_of_tension": {"type": "string"}
        }
      }
    },
    "blind_spots": {"$ref": "#/$defs/stringArray"},
    "knowledge_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strong", "moderate", "personal_experience", "weak", "outside_expertise"],
      "properties": {
        "strong": {"$ref": "#/$defs/stringArray"},
        "moderate": {"$ref": "#/$defs/stringArray"},
        "personal_experience": {"$ref": "#/$defs/stringArray"},
        "weak": {"$ref": "#/$defs/stringArray"},
        "outside_expertise": {"$ref": "#/$defs/stringArray"}
      }
    },
    "relationships_with_council": {"$ref": "#/$defs/stringArray"},
    "design_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["divergence", "convergence", "prototyping", "testing", "evidence", "conflict"],
      "properties": {
        "divergence": {"type": "string"},
        "convergence": {"type": "string"},
        "prototyping": {"type": "string"},
        "testing": {"type": "string"},
        "evidence": {"type": "string"},
        "conflict": {"type": "string"}
      }
    },
    "persistent_project_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "changes_of_mind", "ideas_supported", "ideas_opposed", "unresolved_questions", "surprises", "important_evidence"],
      "properties": {
        "positions": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "changes_of_mind": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "ideas_supported": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "ideas_opposed": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "unresolved_questions": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "surprises": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}},
        "important_evidence": {"type": "array", "items": {"$ref": "#/$defs/memoryEntry"}}
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "concerns", "intellectual_tensions", "active_interests"],
      "properties": {
        "confidence": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "concerns": {"$ref": "#/$defs/stringArray"},
        "intellectual_tensions": {"$ref": "#/$defs/stringArray"},
        "active_interests": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
