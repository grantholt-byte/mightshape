{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/research-session-type.schema.json",
  "title": "Research session type",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "enum": [
        "HUMAN_PULSE",
        "QUALITATIVE_INTERVIEW",
        "PROTOTYPE_TEST",
        "CONCEPT_REACTION",
        "EXPERT_REVIEW",
        "CO_CREATION"
      ]
    },
    "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
    "purpose": {"type": "string", "minLength": 1}
  }
}
