# Shared runtime
DC_TEAM_DATA_DIR=.data
DC_RETENTION_DAYS=30
DC_AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
PYTHON_BIN=python3
# Optional source-checkout override. The former HUNCHGARDEN_REPO_ROOT name is
# accepted only as a migration fallback for existing deployments.
MIGHTSHAPE_REPO_ROOT=

# Slack — Socket Mode is the simplest local test path.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Discord — HTTP interactions endpoint plus bot REST token.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
DISCORD_PORT=3002

# Microsoft Teams SDK / Entra app registration.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
TEAMS_PORT=3978
