{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/eval-case.schema.json",
  "title": "MightShape behavioral evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "title",
    "prompt",
    "invocation",
    "adversarial",
    "expected",
    "invariants",
    "automated",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
    },
    "family": {
      "enum": [
        "routing",
        "design_process",
        "council_humanity",
        "council_independence",
        "inquiry",
        "acceptance"
      ]
    },
    "title": {"type": "string", "minLength": 8},
    "prompt": {"type": "string", "minLength": 8},
    "invocation": {"enum": ["explicit", "implicit", "avoid"]},
    "depth": {
      "enum": ["QUICK_LOOK", "SPRINT", "STANDARD", "DEEP_DESIGN", "AUTO"]
    },
    "adversarial": {"type": "boolean"},
    "setup": {"type": "object"},
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": ["must_demonstrate"],
      "properties": {
        "route": {"type": "string"},
        "must_demonstrate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "must_avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "state_effect": {"type": "string"},
        "provenance": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
    },
    "automated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_match", "must_not_match"],
      "properties": {
        "must_match": {
          "type": "array",
          "items": {"type": "string"}
        },
        "must_not_match": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"}
    },
    "notes": {"type": "string"}
  }
}
