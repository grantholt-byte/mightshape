{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blind Council identity assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments", "overall_notes"],
  "properties": {
    "assignments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "assigned_profile_id", "confidence", "observable_cues"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^A-[0-9]{2}-[0-9]{2}$"},
          "assigned_profile_id": {"type": "string", "pattern": "^P-[0-9]{2}-[0-9]{2}$"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "observable_cues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      }
    },
    "overall_notes": {"type": "string", "minLength": 1, "maxLength": 1200}
  }
}
