# Server-side only. Configure these as Sites runtime secrets/values when hosted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
INTERVIEW_AI_MODE=mock

# Researcher routes deny by default. Configure at least one allowlist or a
# high-entropy API key. Comma-separated values are supported.
RESEARCHER_ALLOWED_USER_IDS=
RESEARCHER_ALLOWED_EMAILS=
RESEARCHER_API_KEY=
RESEARCHER_ALLOW_ANY_AUTHENTICATED=false
