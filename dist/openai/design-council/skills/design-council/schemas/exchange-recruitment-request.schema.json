{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/exchange-recruitment-request.schema.json",
  "title": "Future Design Council Exchange recruitment request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "study_id", "provider", "status", "session_type", "target_count", "experience_signals", "conflict_policy", "project_exposure_level", "credit_estimate", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXR-[0-9]{3,}$"},
    "study_id": {"type": "string", "pattern": "^STUDY-[0-9]{3,}$"},
    "provider": {"const": "EXCHANGE"},
    "status": {"enum": ["NOT_CONFIGURED", "UNAVAILABLE", "FUTURE_FEATURE"]},
    "session_type": {"enum": ["HUMAN_PULSE", "QUALITATIVE_INTERVIEW", "PROTOTYPE_TEST", "CONCEPT_REACTION", "EXPERT_REVIEW", "CO_CREATION"]},
    "target_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "experience_signals": {"type": "array", "items": {"$ref": "experience-signal.schema.json"}},
    "conflict_policy": {"$ref": "conflict-policy.schema.json"},
    "project_exposure_level": {"enum": ["LEVEL_0_PROBLEM_ONLY", "LEVEL_1_ABSTRACTED_CONCEPT", "LEVEL_2_PROTOTYPE_BLIND", "LEVEL_3_CONFIDENTIAL"]},
    "credit_estimate": {"type": "null"},
    "created_at": {"type": "string", "format": "date-time"},
    "message": {"type": "string", "minLength": 1}
  }
}
