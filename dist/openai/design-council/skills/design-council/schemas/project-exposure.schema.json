{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/project-exposure.schema.json",
  "title": "External research project exposure",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "solution_blackout", "concept_reveal_status", "rationale"],
  "properties": {
    "level": {
      "enum": [
        "LEVEL_0_PROBLEM_ONLY",
        "LEVEL_1_ABSTRACTED_CONCEPT",
        "LEVEL_2_PROTOTYPE_BLIND",
        "LEVEL_3_CONFIDENTIAL"
      ]
    },
    "solution_blackout": {"type": "boolean"},
    "concept_reveal_status": {
      "enum": ["NOT_PLANNED", "PLANNED_LATER", "ACTIVE", "COMPLETE"]
    },
    "rationale": {"type": "string", "minLength": 1},
    "confidentiality_controls_status": {
      "enum": ["NOT_APPLICABLE", "NOT_IMPLEMENTED", "EXTERNAL_CONTROL_REQUIRED"]
    }
  }
}
