      "outputs": ["mutations"],
      "council": "recommended",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-ideate.md"
    },
    {
      "id": "crazy-eights",
      "name": "Crazy Eights",
      "modes": ["IDEATE"],
      "purpose": "Force rapid visual or interaction variety.",
