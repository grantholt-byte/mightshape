      "outputs": ["competing frames"],
      "council": "recommended",
      "effort": "high",
      "source_family": "mightshape_original",
      "reference": "methods-define.md"
    },
    {
      "id": "point-of-view",
      "name": "Point of View",
      "modes": ["DEFINE"],
