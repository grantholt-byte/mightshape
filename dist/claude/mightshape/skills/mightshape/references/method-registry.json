      "outputs": ["hybrid concepts"],
      "council": "recommended",
      "effort": "low",
      "source_family": "supplemental_design_practice",
      "reference": "methods-ideate.md"
    },
    {
      "id": "assumption-busting",
      "name": "Assumption Busting",
      "modes": ["IDEATE", "PROTOTYPE"],
