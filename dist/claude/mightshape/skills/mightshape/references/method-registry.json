      "council": "recommended",
      "effort": "low",
      "source_family": "supplemental_design_practice",
      "reference": "methods-ideate.md"
    },
    {
      "id": "opposite-world",
      "name": "Opposite World",
      "modes": ["IDEATE"],
      "purpose": "Invert roles, defaults, incentives, or desired behavior.",
