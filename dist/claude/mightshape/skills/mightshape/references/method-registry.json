      "council": "recommended",
      "effort": "low",
      "source_family": "mightshape_original",
      "reference": "methods-ideate.md"
    },
    {
      "id": "constraint-removal",
      "name": "Constraint Removal",
      "modes": ["IDEATE"],
      "purpose": "Temporarily remove a constraint to expose underlying value.",
