  ],
  "methods": [
    {
      "id": "beginners-mindset",
      "name": "Beginner's Mindset",
      "modes": ["INTAKE", "EMPATHIZE"],
      "purpose": "Expose expert assumptions before inquiry.",
      "use_when": ["solution fixation", "unfamiliar context", "expert overconfidence"],
      "avoid_when": ["used to discard established safety knowledge"],
      "requires": ["challenge"],
      "outputs": ["assumption memo"],
      "council": "optional",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "what-how-why",
      "name": "What? How? Why?",
      "modes": ["EMPATHIZE"],
      "purpose": "Separate observation, process, and inferred meaning.",
      "use_when": ["observation", "artifact analysis", "workflow review"],
      "avoid_when": ["no inspectable material"],
      "requires": ["observation or artifact"],
      "outputs": ["layered observation"],
      "council": "none",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "interview-preparation",
      "name": "Interview Preparation",
      "modes": ["EMPATHIZE", "TEST"],
      "purpose": "Create a flexible, neutral, story-first guide.",
      "use_when": ["human interview planned", "fieldwork kit"],
      "avoid_when": ["decision and learning goal undefined"],
      "requires": ["research goal", "consent plan"],
      "outputs": ["interview guide"],
      "council": "optional",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "interview-for-empathy",
      "name": "Interview for Empathy",
      "modes": ["EMPATHIZE"],
      "purpose": "Reconstruct actual stories, choices, and workarounds.",
      "use_when": ["behavior and meaning matter", "direct participant access"],
      "avoid_when": ["only prevalence is needed", "unsafe or non-consensual context"],
      "requires": ["participant", "consent", "guide"],
      "outputs": ["transcript", "story records"],
      "council": "none",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "contextual-inquiry",
      "name": "Contextual Inquiry",
      "modes": ["EMPATHIZE"],
      "purpose": "Understand real work in its environment with participant explanation.",
      "use_when": ["tools and sequence matter", "workarounds likely", "local workflow"],
      "avoid_when": ["observation would disrupt safety", "context access unavailable"],
      "requires": ["context access", "participant consent"],
      "outputs": ["workflow map", "breakdown records"],
      "council": "none",
      "effort": "high",
      "source_family": "supplemental_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "observation",
      "name": "Observation",
      "modes": ["EMPATHIZE", "TEST"],
      "purpose": "Capture situated behavior separately from interpretation.",
      "use_when": ["say-do gap possible", "environment matters", "prototype use"],
      "avoid_when": ["privacy or safety cannot be protected"],
      "requires": ["scope", "consent or appropriate notice"],
      "outputs": ["observation records"],
      "council": "none",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "immersion",
      "name": "Immersion",
      "modes": ["EMPATHIZE"],
      "purpose": "Generate questions through safe first-person exposure to constraints.",
      "use_when": ["experience can be sampled safely", "team lacks contextual feel"],
      "avoid_when": ["would impersonate lived experience", "unsafe simulation"],
      "requires": ["reflexive plan"],
      "outputs": ["hypotheses", "research questions"],
      "council": "none",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "extreme-users",
      "name": "Extreme Users",
      "modes": ["EMPATHIZE", "IDEATE"],
      "purpose": "Reveal amplified needs and adaptations.",
      "use_when": ["meaningful behavioral extremes exist", "mainstream needs are hard to see"],
      "avoid_when": ["extremes would be stereotyped", "population generalization is the goal"],
      "requires": ["behavioral extreme definition"],
      "outputs": ["amplified needs", "idea prompts"],
      "council": "optional",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "journey-mapping",
      "name": "Journey Mapping",
      "modes": ["EMPATHIZE", "DEFINE"],
      "purpose": "Map evidence-backed sequence, actors, channels, emotion, and breakdowns.",
      "use_when": ["experience unfolds over time", "handoffs or channels matter"],
      "avoid_when": ["team would invent an unsupported happy path"],
      "requires": ["traceable stories or observations"],
      "outputs": ["journey map", "PROCESS_MAP visual artifact and Markdown fallback when spatial sequence helps"],
      "council": "optional",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "stakeholder-mapping",
      "name": "Stakeholder Mapping",
      "modes": ["INTAKE", "EMPATHIZE", "DEFINE"],
      "purpose": "Reveal relationships, power, incentives, benefit, burden, and absence.",
      "use_when": ["service or system challenge", "payer and user differ", "burden may shift"],
      "avoid_when": ["used as an equal-power contact list"],
      "requires": ["initial stakeholder set"],
      "outputs": ["stakeholder map", "missing perspectives"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "supplemental_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "story-share-capture",
      "name": "Story Share and Capture",
      "modes": ["EMPATHIZE", "DEFINE"],
      "purpose": "Make field stories inspectable before synthesis.",
      "use_when": ["multiple researchers", "several participant stories"],
      "avoid_when": ["source traceability cannot be preserved"],
      "requires": ["story records"],
      "outputs": ["evidence wall", "surprises", "questions"],
      "council": "optional",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "analogous-experiences",
      "name": "Analogous Experiences",
      "modes": ["EMPATHIZE", "IDEATE"],
      "purpose": "Transfer hypotheses from researched settings sharing a mechanism.",
      "use_when": ["direct context access is limited", "mechanism is clearer elsewhere"],
      "avoid_when": ["surface analogy without shared mechanism"],
      "requires": ["target mechanism", "analogous research"],
      "outputs": ["mechanism hypotheses", "inspiration"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-empathize.md"
    },
    {
      "id": "assumption-mapping",
      "name": "Assumption Mapping",
      "modes": ["INTAKE", "EMPATHIZE", "PROTOTYPE"],
      "purpose": "Prioritize important weakly evidenced beliefs.",
      "use_when": ["many assumptions", "research time is limited", "prototype focus unclear"],
      "avoid_when": ["confidence would be substituted for evidence"],
      "requires": ["assumption list"],
      "outputs": ["prioritized assumption map"],
      "council": "recommended",
      "effort": "low",
      "source_family": "supplemental_design_practice",
      "reference": "methods-empathize.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "inquiry-lab",
      "name": "Inquiry Lab",
      "modes": ["EMPATHIZE", "TEST"],
      "purpose": "Coordinate research-grounded synthetic and real human inquiry.",
      "use_when": ["unfamiliar domain", "interview preparation", "synthetic-to-human comparison"],
      "avoid_when": ["synthetic work would be presented as human evidence"],
      "requires": ["learning goal", "evidence policy"],
      "outputs": ["Reality Packet", "study", "findings", "Reality Check"],
      "council": "optional",
      "effort": "high",
      "source_family": "mightshape_original",
      "reference": "inquiry-lab.md"
    },
    {
      "id": "research-planning",
      "name": "Research Planning",
      "modes": ["INTAKE", "EMPATHIZE", "TEST"],
      "purpose": "Connect a decision to learning questions, methods, participants, capture, and limits.",
      "use_when": ["multiple inquiry options", "consequential decision"],
      "avoid_when": ["no decision or learning goal"],
      "requires": ["decision to inform"],
      "outputs": ["research plan"],
      "council": "optional",
      "effort": "medium",
      "source_family": "mightshape_original",
      "reference": "methods-empathize.md"
    },
    {
      "id": "affinity-clustering",
      "name": "Affinity Clustering",
      "modes": ["DEFINE"],
      "purpose": "Group evidence by emergent similarity while preserving outliers.",
      "use_when": ["many evidence records", "themes are not yet clear"],
      "avoid_when": ["clusters are preselected to support a concept"],
      "requires": ["source-linked evidence records"],
      "outputs": ["clusters", "outliers", "AFFINITY_MAP visual artifact and Markdown fallback when spatial grouping helps"],
      "council": "optional",
      "effort": "medium",
      "source_family": "supplemental_design_practice",
      "reference": "methods-define.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "pattern-finding",
      "name": "Pattern Finding",
      "modes": ["DEFINE"],
      "purpose": "Identify recurring mechanisms and contextual exceptions.",
      "use_when": ["several stories or observations"],
      "avoid_when": ["sample scope will be hidden"],
      "requires": ["evidence set"],
      "outputs": ["patterns", "negative cases"],
      "council": "optional",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "need-finding",
      "name": "Need Finding",
      "modes": ["DEFINE"],
      "purpose": "Express evidence-backed human needs without solution nouns.",
      "use_when": ["frame contains features", "observations need interpretation"],
      "avoid_when": ["evidence is absent"],
      "requires": ["observations", "patterns"],
      "outputs": ["need candidates"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "tension-finding",
      "name": "Tension Finding",
      "modes": ["DEFINE"],
      "purpose": "Surface goals, values, roles, or constraints that pull against each other.",
      "use_when": ["tradeoffs recur", "several stakeholders", "contradictory behavior"],
      "avoid_when": ["tension would be prematurely resolved"],
      "requires": ["evidence or patterns"],
      "outputs": ["tensions"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "mightshape_original",
      "reference": "methods-define.md"
    },
    {
      "id": "contradiction-mining",
      "name": "Contradiction Mining",
      "modes": ["DEFINE", "TEST"],
      "purpose": "Use say-do gaps, source conflict, and exceptions as learning.",
      "use_when": ["evidence conflicts", "negative cases matter", "frame feels too tidy"],
      "avoid_when": ["used to accuse participants"],
      "requires": ["contradictory records"],
      "outputs": ["alternate explanations", "research questions"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "mightshape_original",
      "reference": "methods-define.md"
    },
    {
      "id": "insight-generation",
      "name": "Insight Generation",
      "modes": ["DEFINE"],
      "purpose": "Turn patterns and tensions into generative supported interpretations.",
      "use_when": ["patterns exist but opportunity is unclear"],
      "avoid_when": ["observation will be relabeled as insight"],
      "requires": ["evidence", "pattern or tension"],
      "outputs": ["insights"],
      "council": "recommended",
      "effort": "high",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "two-by-two",
      "name": "2×2 Matrix",
      "modes": ["DEFINE", "IDEATE"],
      "purpose": "Explore relationships and gaps across two meaningful dimensions.",
