      "outputs": ["alternate scales", "assumptions"],
      "council": "recommended",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "alternative-frames",
      "name": "Alternative Frames",
      "modes": ["DEFINE"],
      "purpose": "Generate obvious, behavioral, systems, and counterintuitive interpretations.",
      "use_when": ["several mechanisms fit", "solution fixation", "consequential framing"],
      "avoid_when": ["alternatives are unsupported wordplay"],
