      "outputs": ["unbounded mechanisms", "constraint insight"],
      "council": "recommended",
      "effort": "low",
      "source_family": "mightshape_original",
      "reference": "methods-ideate.md"
    },
    {
      "id": "analogy-storm",
      "name": "Analogy Storm",
      "modes": ["IDEATE"],
      "purpose": "Transfer researched mechanisms from distant settings.",
