      "requires": ["target mechanism", "analogous examples"],
      "outputs": ["transferred mechanisms"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "supplemental_design_practice",
      "reference": "methods-ideate.md"
    },
    {
      "id": "mash-up",
      "name": "Mash-Up",
      "modes": ["IDEATE"],
      "purpose": "Combine distant elements into a new mechanism.",
