      "avoid_when": ["inversion has no learning purpose"],
      "requires": ["current convention"],
      "outputs": ["inverted concepts"],
      "council": "recommended",
      "effort": "low",
      "source_family": "mightshape_original",
      "reference": "methods-ideate.md"
    },
    {
      "id": "constraint-storm",
      "name": "Constraint Storm",
      "modes": ["IDEATE"],
