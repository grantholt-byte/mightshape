      "outputs": ["ladder", "candidate frame"],
      "council": "optional",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "powers-of-ten",
      "name": "Powers of Ten",
      "modes": ["DEFINE", "IDEATE"],
      "purpose": "Reveal scale-dependent frames, mechanisms, and assumptions.",
