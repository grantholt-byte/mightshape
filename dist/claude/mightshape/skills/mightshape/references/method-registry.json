      "avoid_when": ["hierarchy or anchoring dominates"],
      "requires": ["HMW", "protected divergence"],
      "outputs": ["ideas"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "public_design_practice",
      "reference": "methods-ideate.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "brainwriting",
      "name": "Brainwriting",
      "modes": ["IDEATE"],
      "purpose": "Generate independently before social influence.",
      "use_when": ["anchoring risk", "uneven airtime", "sealed round"],
      "avoid_when": ["used as premature voting"],
      "requires": ["common prompt"],
      "outputs": ["independent ideas"],
      "council": "recommended",
      "effort": "medium",
      "source_family": "supplemental_design_practice",
      "reference": "methods-ideate.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "yes-and",
      "name": "Yes-And",
      "modes": ["IDEATE"],
      "purpose": "Extend a useful kernel with a new mechanism or context.",
