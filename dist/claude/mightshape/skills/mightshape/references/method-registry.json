      "avoid_when": ["question embeds the chosen artifact"],
      "requires": ["POV"],
      "outputs": ["HMW questions"],
      "council": "recommended",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-define.md",
      "participation_modes": ["OBSERVE", "COLLABORATE", "FACILITATED_TURN_BY_TURN"]
    },
    {
      "id": "classic-brainstorm",
      "name": "Classic Brainstorm",
      "modes": ["IDEATE"],
      "purpose": "Generate quantity and combinations around one HMW.",
