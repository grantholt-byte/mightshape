      "avoid_when": ["treated as an endorsement"],
      "requires": ["desired outcome"],
      "outputs": ["automation extreme", "failure assumptions"],
      "council": "recommended",
      "effort": "low",
      "source_family": "mightshape_original",
      "reference": "methods-ideate.md"
    },
    {
      "id": "ten-x",
      "name": "10×",
      "modes": ["IDEATE"],
      "purpose": "Force system-level mechanisms at an order-of-magnitude scale change.",
