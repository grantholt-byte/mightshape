      "outputs": ["matrix", "gaps", "questions"],
      "council": "optional",
      "effort": "low",
      "source_family": "public_design_practice",
      "reference": "methods-define.md"
    },
    {
      "id": "why-how-laddering",
      "name": "Why-How Laddering",
      "modes": ["DEFINE"],
      "purpose": "Find a frame altitude between empty universals and solution details.",
      "use_when": ["frame too broad", "frame too narrow", "meaning and action are disconnected"],
      "avoid_when": ["why claims would be treated as evidence"],
