{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-council.local/schemas/assumption.schema.json",
  "title": "MightShape assumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "status", "risk", "importance", "evidence_ids", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^A-[0-9]{3,}$"},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["RESOLVED", "TESTING", "OPEN_HIGH_RISK", "OPEN_LOW_RISK", "FALSIFIED"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "importance": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[0-9]{3,}$"}, "uniqueItems": true},
    "experiment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "resolution_note": {"type": ["string", "null"]}
  }
}
